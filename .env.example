# Local development (SQLite). Docker/Dockge uses PostgreSQL — see deploy/.env.example
DATABASE_URL="file:./dev.db"
SESSION_SECRET=local-dev-session-secret-printdrop-smoke-run-32chars!!
PRINT_API_KEY=local-dev-print-api-key-smoke-run
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
CUPS_SERVER=localhost
PRINTER_NAME=HP_LaserJet_M15w
UPLOADS_ROOT=./data/uploads
TMP_ROOT=./data/tmp
SECURE_COOKIES=false
FORCE_PASSWORD_CHANGE_DEFAULT=false
RUN_SCHEDULER=false
PORT=8000
TZ=UTC
MAX_UPLOAD_MB=20
