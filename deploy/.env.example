# Image selection — replace OWNER with your GitHub org/user, or set via CI
PRINTDROP_IMAGE=ghcr.io/OWNER/printdrop:latest

# App exposure
PRINTDROP_PORT=8000
TZ=UTC

# Database (Prisma PostgreSQL URL — note: no +psycopg suffix)
POSTGRES_DB=printdrop
POSTGRES_USER=printdrop
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql://printdrop:change-me-strong-password@postgres:5432/printdrop

# PrintDrop application secrets
SESSION_SECRET=replace-with-64-char-random-secret
PRINT_API_KEY=replace-with-long-random-api-key

# Bootstrap admin (first startup only)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-admin-password

# Printer + CUPS
# If CUPS runs on host, use host.docker.internal (Linux requires host-gateway support)
CUPS_SERVER=host.docker.internal
PRINTER_NAME=HP_LaserJet_M15w

# Runtime controls
RUN_SCHEDULER=false
FORCE_PASSWORD_CHANGE_DEFAULT=true
RETAIN_SUCCESSFUL_UPLOADS=false
PRINT_STATUS_POLL_SECONDS=30
FAILED_FILE_RETENTION_HOURS=72
PENDING_FILE_RETENTION_DAYS=14
MAX_UPLOAD_MB=20
# false for direct HTTP (:8000). Set true only when the browser reaches PrintDrop over HTTPS
# (TLS reverse proxy). Secure cookies are dropped by browsers on plain HTTP, which breaks login.
SECURE_COOKIES=false
LOGIN_RATE_LIMIT_PER_MINUTE=12
UPLOAD_RATE_LIMIT_PER_MINUTE=30
